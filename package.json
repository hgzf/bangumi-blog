{
  "name": "bgm-local-blog",
  "version": "1.0.0",
  "description": "纯本地 Bangumi 个人博客与碎碎念日志桌面客户端",
  "main": "main.js",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./tailwind.input.css -o ./styles.css --minify",
    "build:web": "pnpm run build:css && node scripts/build-web.mjs",
    "check:web": "node scripts/check-web-build.mjs",
    "test": "node --test tests/*.test.js",
    "start": "tailwindcss -i ./tailwind.input.css -o ./styles.css --minify && electron .",
    "start:fast": "electron ."
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.11.1",
    "dompurify": "^3.2.4",
    "marked": "^15.0.7",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "electron": "^45.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17"
  }
}
