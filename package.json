{
  "name": "bgm-local-blog",
  "version": "1.0.0",
  "description": "纯本地 Bangumi 个人博客与碎碎念日志桌面及 Android 客户端",
  "author": "hgzf",
  "license": "MIT",
  "homepage": "https://github.com/hgzf/bgm-local-blog#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hgzf/bgm-local-blog.git"
  },
  "bugs": {
    "url": "https://github.com/hgzf/bgm-local-blog/issues"
  },
  "keywords": [
    "bangumi",
    "blog",
    "journal",
    "electron",
    "capacitor",
    "android",
    "vue3",
    "local-first",
    "syncthing"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "main.js",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./tailwind.input.css -o ./styles.css --minify",
    "build:web": "pnpm run build:css && node scripts/build-web.mjs",
    "check:web": "node scripts/check-web-build.mjs",
    "test": "node --test tests/*.test.js",
    "start": "tailwindcss -i ./tailwind.input.css -o ./styles.css --minify && electron .",
    "start:fast": "electron ."
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@highlightjs/cdn-assets": "^11.11.1",
    "dompurify": "^3.2.4",
    "marked": "^15.0.7",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.6.0",
    "autoprefixer": "^10.4.20",
    "electron": "^45.1.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17"
  }
}
